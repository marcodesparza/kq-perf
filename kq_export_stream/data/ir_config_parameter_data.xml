<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Parámetros de sistema publicados en el manifest. Se crean al instalar
        (solo si no existen) para que aparezcan en Ajustes > Técnico > Parámetros
        > Parámetros del sistema. Al actualizar el módulo no se sobrescriben
        los valores que haya modificado el usuario.

        Se usa <function model="ir.config_parameter" name="set_param"> en lugar
        de <record> para evitar errores de clave duplicada cuando el parámetro
        ya existe en la base de datos sin el xml_id correspondiente.
    -->
    <function model="ir.config_parameter" name="set_param">
        <value>kq_export_stream.enabled</value>
        <value>True</value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>kq_export_stream.batch_size</value>
        <value>1000</value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>kq_export_stream.max_records</value>
        <value>0</value>
    </function>
</odoo>
