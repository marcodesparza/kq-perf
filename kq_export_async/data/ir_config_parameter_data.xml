<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Parámetros de sistema publicados en el manifest. Se crean al instalar
        para que aparezcan en Ajustes > Técnico > Parámetros > Parámetros del
        sistema, pero el usuario puede modificarlos sin que se sobreescriban
        al actualizar el módulo.
    -->
    <record id="param_threshold" model="ir.config_parameter">
        <field name="key">kq_export_async.threshold</field>
        <field name="value">0</field>
    </record>
    <record id="param_jobs_per_run" model="ir.config_parameter">
        <field name="key">kq_export_async.jobs_per_run</field>
        <field name="value">2</field>
    </record>
    <record id="param_retention_days" model="ir.config_parameter">
        <field name="key">kq_export_async.retention_days</field>
        <field name="value">7</field>
    </record>
    <record id="param_stale_running_minutes" model="ir.config_parameter">
        <field name="key">kq_export_async.stale_running_minutes</field>
        <field name="value">30</field>
    </record>
</odoo>
