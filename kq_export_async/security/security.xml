<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_kq_export_job_own" model="ir.rule">
        <field name="name">kq.export.job: cada usuario ve sus propios jobs</field>
        <field name="model_id" ref="model_kq_export_job"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_kq_export_job_system" model="ir.rule">
        <field name="name">kq.export.job: administradores ven todo</field>
        <field name="model_id" ref="model_kq_export_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
