<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kq_export_job_list" model="ir.ui.view">
        <field name="name">kq.export.job.list</field>
        <field name="model">kq.export.job</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="model_name"/>
                <field name="export_format"/>
                <field name="record_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'running'"
                       decoration-danger="state == 'error'"/>
                <field name="done_at"/>
            </list>
        </field>
    </record>

    <record id="view_kq_export_job_form" model="ir.ui.view">
        <field name="name">kq.export.job.form</field>
        <field name="model">kq.export.job</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_download" type="object" string="Descargar"
                            class="btn-primary" invisible="state != 'done' or not attachment_id"/>
                    <button name="action_retry" type="object" string="Reintentar"
                            invisible="state != 'error'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,running,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="model_name"/>
                            <field name="export_format"/>
                            <field name="record_count"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="done_at"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Parámetros">
                        <field name="payload" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kq_export_job" model="ir.actions.act_window">
        <field name="name">Exports asíncronos</field>
        <field name="res_model">kq.export.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kq_export_job"
              name="Exports asíncronos"
              parent="base.menu_custom"
              action="action_kq_export_job"
              sequence="99"/>
</odoo>
